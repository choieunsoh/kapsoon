{
  "name": "kapsoon",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"for (const f of ['public/sw.js', 'public/sw.js.map']) require('fs').rmSync(f, { force: true })\"",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.ts",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "dependencies": {
    "@serwist/next": "^9.5.11",
    "drizzle-orm": "^0.45.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serwist": "^9.5.11",
    "sqlocal": "^0.18.0"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "semver": "^7.8.5",
    "simple-git": "^3.36.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vercel": "^65.7.0",
    "vite": "^8.1.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
